<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Transcripts are local-only by design; never upload to Google's cloud backup. -->
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" />
        <include domain="file" />
    </device-transfer>
</data-extraction-rules>
